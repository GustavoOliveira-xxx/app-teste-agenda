# Copie este arquivo para ".env" (na mesma pasta app-mobile) e preencha.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Painel do Supabase > Project Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Painel do Supabase > Project Settings > API Keys > Publishable key (ou "anon")
# Esta chave é pública por natureza (vai dentro do APK). A proteção dos dados
# vem das regras de acesso (RLS) do banco. NUNCA use a chave "secret"/"service_role".
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
