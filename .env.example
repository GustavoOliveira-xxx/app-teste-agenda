# ---------------------------------------------------------------
# Modelo de variáveis de ambiente do projeto
# Copie os valores do app para app-mobile/.env (veja app-mobile/.env.example).
# Este arquivo é só um modelo: NUNCA coloque valores reais aqui.
# ---------------------------------------------------------------

# === App (app-mobile/.env) ===
# Endereço do seu projeto Supabase (Painel > Project Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon). É pública por natureza: vai dentro do APK
# e só funciona com as regras de segurança (RLS) do banco.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# === GitHub Actions (cadastrar em Settings > Secrets and variables > Actions) ===
# Variables (não secretas):
#   EXPO_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY
# Secrets (secretas, opcionais, para assinar o APK com sua própria chave):
#   ANDROID_KEYSTORE_BASE64
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD

# Nunca use no app a chave "service_role" / "secret" do Supabase.
